# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google AI Studio (Gemini) - Optional
# Lấy API key tại: https://aistudio.google.com/apikey
# Nếu không có, bot sẽ dùng summary từ RSS
GEMINI_API_KEY=your_gemini_api_key_here
# Tùy chọn model khác; mặc định bot dùng danh sách model stable có fallback
# GEMINI_MODEL=gemini-3.5-flash-lite

# News filtering
ARTICLE_LOOKBACK_HOURS=24
NEWS_ARTICLE_COUNT=15

# Optional: Nếu gặp lỗi SSL khi fetch RSS
# RSS_INSECURE=0
